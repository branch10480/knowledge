{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://branch10480.github.io/knowledge/schemas/entry.schema.json",
  "title": "Knowledge entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "source_id", "external_id", "canonical_url",
    "published_at", "collected_at", "title", "summary",
    "tags", "language", "source_digest", "summary_model", "review"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 4, "maxLength": 64, "pattern": "^kn_[A-Za-z0-9]+$" },
    "source_id": { "type": "string", "minLength": 1, "maxLength": 64 },
    "external_id": { "type": "string", "minLength": 1, "maxLength": 512 },
    "canonical_url": { "type": "string", "format": "uri", "maxLength": 2048 },
    "published_at": { "type": "string", "format": "date-time" },
    "collected_at": { "type": "string", "format": "date-time" },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "key_points": {
      "type": "array", "maxItems": 10,
      "items": { "type": "string", "minLength": 1, "maxLength": 300 }
    },
    "tags": {
      "type": "array", "maxItems": 10,
      "items": { "type": "string", "minLength": 1, "maxLength": 32 }
    },
    "language": { "type": "string", "enum": ["ja", "en"] },
    "source_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "summary_model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "prompt_version"],
      "properties": {
        "provider": { "type": "string" },
        "model": { "type": "string" },
        "prompt_version": { "type": "string" }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["factual_gate", "checked_at"],
      "properties": {
        "factual_gate": { "enum": ["passed", "quarantined"] },
        "checked_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
