{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://branch10480.github.io/knowledge/schemas/summary-output.schema.json",
  "title": "LLM summary output",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidate_id", "title_ja", "summary_ja", "tags", "insufficient_evidence"],
  "properties": {
    "candidate_id": { "type": "string", "minLength": 1 },
    "title_ja": { "type": "string", "minLength": 1, "maxLength": 200 },
    "summary_ja": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "key_points": {
      "type": "array", "maxItems": 10,
      "items": { "type": "string", "minLength": 1, "maxLength": 300 }
    },
    "tags": {
      "type": "array", "maxItems": 10,
      "items": { "type": "string", "minLength": 1, "maxLength": 32 }
    },
    "claims": {
      "type": "array", "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "evidence_quotes"],
        "properties": {
          "text": { "type": "string", "minLength": 1, "maxLength": 500 },
          "evidence_quotes": {
            "type": "array", "maxItems": 10,
            "items": { "type": "string", "minLength": 1, "maxLength": 300 }
          }
        }
      }
    },
    "insufficient_evidence": { "type": "boolean" }
  }
}
