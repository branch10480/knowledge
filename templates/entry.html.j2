{% extends "base.html.j2" %}
{% block body_view %}single{% endblock %}
{% block title %}{{ entry.title }}{% endblock %}
{% block content %}
<div class="content-area">
<a href="{{ url('index.html') }}" class="back-link">← Back to all entries</a>
<header class="entry-detail-header">
<h1>{{ entry.title }}</h1>
<div class="entry-meta">
<time datetime="{{ entry.published_at }}">{{ entry.published_at[:10] }}</time>
{% if entry.tags %}{% for t in entry.tags %}<span class="tag-pill">{{ t }}</span>{% endfor %}{% endif %}
</div>
</header>
<div class="entry-tags" hidden></div>
<div class="entry-body">
<p>{{ entry.summary }}</p>
{% if entry.key_points %}
<ul>
{% for kp in entry.key_points %}<li>{{ kp }}</li>{% endfor %}
</ul>
{% endif %}
</div>
<p class="entry-meta">出典: <span class="entry-source"><a href="{{ entry.canonical_url }}" target="_blank" rel="noopener">{{ entry_source_host }}</a></span></p>
{% if related %}
<div class="related-entries">
<h3>関連エントリ</h3>
<ul>
{% for r in related %}
<li><a href="{{ url('entry', r.id + '.html') }}">{{ r.title }}</a> <span class="date">({{ r.published_at[:10] }})</span></li>
{% endfor %}
</ul>
</div>
{% endif %}
</div>
{% endblock %}
